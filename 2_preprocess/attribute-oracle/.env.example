# Copy to .env and set the dongle's serial port for your host.
# Find it with:  ls -l /dev/serial/by-id/   (Linux)   or   ls /dev/tty.usb*  (macOS)
#
# Prefer the stable by-id path on Linux so it survives replug:
#   /dev/serial/by-id/usb-ITead_Sonoff_Zigbee_3.0_USB_Dongle_Plus_XXXXXXXX-if00-port0
ZIGBEE_SERIAL_PORT=/dev/ttyACM0

# Optional: container timezone for readable log timestamps.
TZ=UTC
